# Put here configuration related to environment and tools
# For a complete list of options, see:
# https://pyflow-wellies.readthedocs.io/latest/config/tools_config/#tool-types
ecflow_variables:
  MODULES_VERSION: "new"

tools:

  # ---------- System modules ---------------------------------------------------
  modules:
    python:
      name: python3
      version: $MODULES_VERSION
    ecmwf-toolbox:
      version: $MODULES_VERSION
      depends: [python]

  # ---------- Extra installables -----------------------------------------------
  packages:
    earthkit_data:
      type: git
      source: git@github.com:ecmwf/earthkit-data.git
      branch: develop
      post_script: "pip install . --no-deps"
    scripts:
      type: copy
      source: "{ROOT}/bin"
      files: ["hello_world.py"]
      post_script: "cp *.py $LIB_DIR/${ENV_NAME:-}/bin"

  env_variables:
    USE_FINDLIBS:
      variable: "ECCODES_PYTHON_USE_FINDLIBS"
      value: "1"

  # --------Virtual envs --------------------------------------------------
  environments:
      suite_env:
          type: system_venv
          depends: [python, ecmwf-toolbox, USE_FINDLIBS]  # loadable dependencies
          packages: [earthkit_data, scripts]              # installables resources that environment make available
