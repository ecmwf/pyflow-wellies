import os
import pyflow as pf
import wellies as wl


class WelliesTask(pf.Task): #(wl.EcfResourcesTask):
    def __init__(self, **kwargs):
        name = kwargs.get('name')
        config = kwargs.get('config', None)
        # adapt default submit_arguments
        submit_arguments = kwargs.get('submit_arguments', 'sequential')
        submit_arguments['job_name'] = name
        # add default preamble
        env = kwargs.get('env', 'suite_env')
        modules = kwargs.get('modules', ['python3', 'ecmwf-toolbox'])
        # add default script decoration
        script = kwargs.get('script', [])
        script_args = kwargs.get('script_args', {})
        kwargs['script'] += [config.tools.load(env)]
        kwargs['script'] += [config.tools.load('ps4')]
        # kwargs['script'] += pf.FileScript(os.path.join(config.global_vars['projectDir'], 'snippets', name))
        kwargs['script'] += pf.TemplateFileScript(os.path.join(config.global_vars['projectDir'], 'snippets', name), **script_args)
        # add default variables        
        variables = kwargs.get('variables', {})
        variables.update(
            {
                "DEBUG": 0,
                "VERBOSE": 0
            }
        )
        # add default attributes
        label = kwargs.get('label', pf.Label('info', 'This is a wellies task'))
        event = kwargs.get('event', pf.Event("set_event"))
        manual = kwargs.get('manual', "\n".join(pf.TemplateFileScript(os.path.join(config.input_dir, 'manuals', name+'.man')).generate()))
        inlimits = kwargs.get('inlimits', [])
        # init the pf.Task object
        super().__init__(
            name = name,
            variables=variables,
            submit_arguments=submit_arguments,
            script=script,
            #meters=meter,
            events=event,
            labels=label,
            manual=manual,
            modules=modules,
            inlimits = inlimits,
            kwargs=kwargs
        )
        print(f"   Built WelliesTask '{name}'.")
        print('-----------------------------------')
 

class InitFamily(pf.AnchorFamily):
    def __init__(self, config, **kwargs):
        super().__init__(name='init', **kwargs)
        with self:
            # install environments and packages
            tools_family = wl.DeployToolsFamily(
                config.tools,
                submit_arguments="sequential",
            )

            # setup static data (remote/local copy/link)
            data_family = wl.DeployDataFamily(
                config.static_data,
                submit_arguments="sequential",
            )
            
            # set up static source code used in the suite tasks
            src_family = wl.DeployDataFamily(
                config.src,
                name='deploy_src',
                submit_arguments="sequential"
            )
            
            # clean task
            clean_task = wl.EcfResourcesTask(
                'clean_init',
                submit_arguments="sequential",
                script=pf.TemplateFileScript("snippets/clean_init"))
            
            # set triggers
            tools_family >> data_family >> src_family >> clean_task


class MainFamily(pf.AnchorFamily):
    def __init__(self, config, **kwargs):
        super().__init__(name='main', **kwargs)
        with self:
            t_dummy_pyflow = pf.Task(
                name='dummy_plain',
                submit_arguments="sequential",
                    script=[
                        config.tools.load('suite_env'),
                        config.tools.load('ps4'),
                        pf.TemplateFileScript("snippets/dummy")
                    ]
            )
            t_dummy_wellies = WelliesTask(
                config=config,
                name="dummy_wellies", 
            )


class Suite(pf.Suite):
    def __init__(self, config, **kwargs):
        super().__init__(defstatus=pf.state.suspended, **kwargs)

        with self:

            f_init = InitFamily(config=config, inlimits="work")
            f_main = MainFamily(config=config, inlimits="work")
            f_main.triggers = f_init.complete