# Put here configuration related to environment and tools
# For a complete list of options, see:
# https://pyflow-wellies.readthedocs.io/latest/config/tools_config/#tool-types
ecflow_variables:
  MODULES_VERSION: "new"

tools:

  # ---------- System modules ---------------------------------------------------
  modules:
    python:
      name: python3
      version: $MODULES_VERSION
    ecmwf-toolbox:
      version: $MODULES_VERSION
      depends: [python]

  # ---------- Extra installables -----------------------------------------------
  packages:
    xarray:
      type: custom
      post_script: "python -m pip install xarray"
    earthkit:
      type: git
      source: git@github.com:ecmwf/earthkit-data.git
      branch: develop
      post_script: "python -m pip install . --no-deps"

  # --------Virtual envs --------------------------------------------------
  environments:
      suite_env:
          type: system_venv
          depends: [python, ecmwf-toolbox]
          packages: [earthkit, xarray]

  # --------Environment variables -----------------------------------------
  env_variables:
    ps4:
      variable: PS4
      value: '"[ \D{{%Y-%m-%dT%H:%M:%S}} | L\$LINENO ] --> "'